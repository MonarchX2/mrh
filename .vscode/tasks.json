{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MRH: start local SPA server",
      "type": "npm",
      "script": "start:dev",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "mrh-local-server",
        "pattern": [
          {
            "regexp": "^(?!)(.*)$",
            "file": 1,
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Maritime Review Hub development server listening at",
          "endsPattern": "$^"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}
